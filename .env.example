# Porta da aplicação
PORT=3001

# Banco de dados exclusivo do serviço de Usuários (PostgreSQL)
# Para desenvolvimento local direto no host (com usuarios-db mapeado na 5433):
DATABASE_URL=postgresql://usuarios:usuarios@localhost:5433/usuarios

# RabbitMQ
# Para desenvolvimento local direto no host:
RABBITMQ_URL=amqp://guest:guest@localhost:5672
